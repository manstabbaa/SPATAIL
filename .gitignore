# ─── OS / editor ───────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ─── Python ────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# ─── Node ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ─── Blender (heavy binaries; rebuild from .obj via
#     skills, or ship via git-lfs / external bucket) ─
*.blend
*.blend1
*.blend2
*.blend@

# Raw AI-generated model inputs are user-supplied and external — never tracked.
# Only the README explaining the drop-folder workflow stays in git.
assets_raw/*
!assets_raw/README.md

# ─── Bundle staging (interim dirs from spatail_export_xr) ─
bundles/*.stage/
*.spatail.stage/

# ─── Xcode ─────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
build/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
.swiftpm/

# Generated by `xcodegen generate`
ios/**/*.xcodeproj/
ios/SpatailEducator/Sources/Info.plist

# Swift Package Manager local state
.build/
Package.resolved

# ─── SPATAIL artifacts ─────────────────────────────
# Treatment study JSONs are computed; usually small,
# tracked when useful. Strip clearly-volatile caches.
# 4.7GB of segmented meshes — regenerable from skills
assets_processed/
# vision-guided pipeline output (renders + heavy GLB/USDZ exports; regenerable)
asset_output/
# ─── AI Asset Factory runtime output (regenerable; config/ + code stay tracked) ─
asset_factory/cache/
asset_factory/logs/
asset_factory/reports/
asset_factory/previews/
docs/screenshots/_tmp/
# built web viewer artifacts
dist/
# Meshy image-to-3D — heavy binaries (12-22MB USDZ each); kept on the PC disk and
# served over Tailscale, regenerable via studio/meshy/pipeline.py. Code IS tracked.
/studio/out/meshy/
/public/assets/spatail-library/meshy/
# external API keys live OUTSIDE the repo (~/.spatail/secrets.env) — never commit
*.env
secrets.env

# Claude / agent local state
.claude/projects/
.claude/state/

# ─── OS-specific runtime junk ──────────────────────
*.log
*.tmp

# ─── Files exceeding GitHub's 100MB hard limit (use LFS/external if needed) ─
engineexplainer/engine/v8_engine.glb
renders/kitchen_xr_risotto_step5.glb
