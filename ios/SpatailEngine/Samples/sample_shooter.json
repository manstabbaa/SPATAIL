{
  "schemaVersion": "0.8-spatail-engine",
  "id": "room_shooter_demo",
  "title": "Room Target Range",
  "genre": "shooter",
  "kit": "shooter",

  "params": { "targetScore": 5, "points": 1 },

  "anchoring": { "mode": "world", "fallback": "world" },
  "placement": { "anchorType": "floor", "scaleMode": "true_scale" },

  "blackboard": { "score": 0 },

  "entities": [
    {
      "id": "spawner1",
      "tags": ["spawner"],
      "primitive": "box",
      "size": [0.05, 0.05, 0.05],
      "hittable": false,
      "transform": { "position": [0, 1.0, -2.5] },
      "components": [
        { "type": "spawner", "fields": { "template": "target", "interval": 2.0, "infinite": 1, "jitter": 0.6 } }
      ]
    }
  ],

  "templates": [
    {
      "id": "target",
      "primitive": "sphere",
      "size": [0.25, 0.25, 0.25],
      "color": "#D85A30",
      "tags": ["target"],
      "components": [ { "type": "health", "fields": { "hp": 1, "max": 1 } } ],
      "physics": { "mode": "static", "body": "rigid", "mass": 1, "collider": "sphere" }
    },
    {
      "id": "projectile",
      "primitive": "sphere",
      "size": [0.08, 0.08, 0.08],
      "color": "#378ADD",
      "tags": ["projectile"],
      "components": [
        { "type": "projectile", "fields": { "damage": 1 } },
        { "type": "lifetime", "fields": { "ttl": 3 } }
      ],
      "physics": { "mode": "dynamic", "body": "bouncy", "mass": 0.2, "collider": "sphere" }
    }
  ],

  "rules": [],
  "objectives": []
}
